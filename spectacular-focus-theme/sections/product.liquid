{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-page">
  <div class="product-layout">
    <div class="product-images">
      {% for image in product.images %}
        {% render 'image', class: 'product-image', image: image %}
      {% endfor %}
    </div>

    <div class="product-details">
      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <p>{{ product.price | money }}</p>
        <p>{{ product.description }}</p>
      </div>

      <div class="product-form">
        {% form 'product', product %}
          {% assign current_variant = product.selected_or_first_available_variant %}

          <select name="id">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant == current_variant %}
                  selected="selected"
                {% endif %}
              >
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>

          <input type="text" name="quantity" min="1" value="1">

          <input type="submit" value="Add to cart">
          {{ form | payment_button }}
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .product-page .product-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: 3rem;
  }

  .product-page .product-images {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .product-page .product-image {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    max-height: 42rem;
    background-color: color-mix(in srgb, var(--color-foreground) 3%, var(--color-background));
  }

  .product-page .product-image > img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-page .product-details {
    display: grid;
    gap: 2rem;
    min-width: 0;
  }

  .product-page .product-info {
    display: grid;
    gap: 1rem;
  }

  .product-page .product-info h1 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.15;
  }

  .product-page .product-form form {
    display: grid;
    gap: 1rem;
  }

  .product-page .product-form select,
  .product-page .product-form input {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
  }

  .product-page .product-form input[type='submit'] {
    border: 0;
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-foreground);
    color: var(--color-background);
    cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-page .product-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-block: 1.5rem;
    }

    .product-page .product-image {
      max-height: 70svh;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
