{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<section class="cart-page" aria-labelledby="cart-title">
  <h1 id="cart-title">{{ 'cart.title' | t }}</h1>

  <form class="cart-form" action="{{ routes.cart_url }}" method="post">
    <div class="cart-items">
      {% for item in cart.items %}
        <article class="cart-item">
          {% render 'image',
            class: 'cart-item__image',
            image: item.image,
            url: item.url,
            width: 240,
            height: 240,
            crop: 'center'
          %}

          <div class="cart-item__details">
            <h2 class="cart-item__title">
              <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
            </h2>
            <p class="cart-item__price">{{ item.final_line_price | money }}</p>
            {{ 'cart.remove' | t | link_to: item.url_to_remove, class: 'cart-item__remove' }}
          </div>

          <div class="cart-item__quantity">
            <label for="CartQuantity-{{ forloop.index }}">Quantity</label>
            <input
              id="CartQuantity-{{ forloop.index }}"
              type="number"
              name="updates[]"
              value="{{ item.quantity }}"
              min="0"
              step="1"
              inputmode="numeric"
            >
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="cart-actions">
      <button class="cart-actions__update" type="submit">{{ 'cart.update' | t }}</button>
      <button class="cart-actions__checkout" type="submit" name="checkout" value="{{ 'cart.checkout' | t }}">
        {{ 'cart.checkout' | t }}
      </button>
    </div>
  </form>
</section>

{% stylesheet %}
  .cart-page {
    width: 100%;
    min-width: 0;
    max-width: var(--page-width);
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 4rem) var(--page-margin);
  }

  .cart-page h1 {
    margin-block-end: 1.5rem;
  }

  .cart-form,
  .cart-items,
  .cart-item,
  .cart-item__details {
    min-width: 0;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) minmax(8rem, auto);
    align-items: center;
    gap: 1rem 1.5rem;
    padding-block: 1.5rem;
    border-block-start: 1px solid currentcolor;
  }

  .cart-item__image {
    grid-row: span 2;
    width: 7rem;
    border-radius: var(--style-border-radius-inputs);
  }

  .cart-item__image img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .cart-item__details {
    overflow-wrap: anywhere;
  }

  .cart-item__title {
    font-size: 1.125rem;
    line-height: 1.35;
  }

  .cart-item__title a {
    color: inherit;
    text-decoration: none;
  }

  .cart-item__price {
    margin-block-start: 0.5rem;
    font-weight: 600;
  }

  .cart-item__remove {
    display: inline-block;
    margin-block-start: 0.5rem;
  }

  .cart-item__quantity {
    grid-column: 3;
    grid-row: 1 / span 2;
    display: grid;
    gap: 0.5rem;
  }

  .cart-item__quantity label {
    font-size: 0.875rem;
  }

  .cart-item__quantity input {
    width: 5rem;
    min-height: 3rem;
    padding: 0.5rem;
    text-align: center;
  }

  .cart-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
    padding-block-start: 1.5rem;
  }

  .cart-actions button {
    min-height: 3rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid currentcolor;
    border-radius: var(--style-border-radius-inputs);
    font: inherit;
    cursor: pointer;
  }

  .cart-actions__update {
    color: var(--color-foreground);
    background: var(--color-background);
  }

  .cart-actions__checkout {
    color: var(--color-background);
    background: var(--color-foreground);
  }

  @media screen and (max-width: 600px) {
    .cart-item {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: 0.75rem 1rem;
      padding-block: 1rem;
    }

    .cart-item__image {
      grid-column: 1;
      grid-row: 1 / span 2;
      width: 5rem;
    }

    .cart-item__title {
      font-size: 1rem;
    }

    .cart-item__quantity {
      grid-column: 2;
      grid-row: 2;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .cart-item__quantity input {
      width: 4.5rem;
    }

    .cart-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
